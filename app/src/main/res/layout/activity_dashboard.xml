<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    tools:context=".DashboardActivity">

    <!-- MAIN CONTENT -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ================= HEADER ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#6B21B6"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- TOP BAR -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- MENU -->
                        <ImageView
                            android:id="@+id/btn_menu"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_menu"
                            app:tint="#FFFFFF"
                            android:padding="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <!-- LOGO -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/btn_menu"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:src="@drawable/osebo"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Osebo"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- ACTION ICONS -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                android:id="@+id/btn_refresh"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_refresh"
                                app:tint="#FFFFFF"
                                android:padding="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"/>

                            <ImageView
                                android:id="@+id/btn_notification"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="14dp"
                                android:src="@drawable/ic_notification"
                                app:tint="#FFFFFF"
                                android:padding="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"/>

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="14dp"
                                android:src="@drawable/user_avatar"
                                app:shapeAppearanceOverlay="@style/CircleImage"/>
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- WELCOME TEXT -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Welcome Back 👋"
                        android:textColor="#E9D5FF"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lwanyaga Ivan"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <!-- BALANCE CARD -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardCornerRadius="22dp"
                        app:cardBackgroundColor="#7C3AED">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="22dp">

                            <TextView
                                android:text="Total Balance"
                                android:textColor="#E9D5FF"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_marginTop="10dp"
                                android:text="UGX 12,450,000"
                                android:textColor="#FFFFFF"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textSize="30sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_marginTop="10dp"
                                android:text="↑ 18% this month"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textColor="#FFFFFF"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ================= BODY ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- SEARCH -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="-30dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_search"
                                app:tint="#94A3B8"/>

                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="Search products, shops..."
                                android:textColor="#111827"
                                android:textColorHint="#94A3B8"/>
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- QUICK ACTIONS -->
                    <TextView
                        android:layout_marginTop="26dp"
                        android:text="Quick Actions"
                        android:textSize="20sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textStyle="bold"
                        android:textColor="#111827"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="18dp">

                            <LinearLayout
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:src="@drawable/ic_cart"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    app:tint="#6B21B6"/>

                                <TextView
                                    android:text="New Sale"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="8dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="110dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="18dp">

                            <LinearLayout
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:src="@drawable/store"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    app:tint="#10B981"/>

                                <TextView
                                    android:text="Shops"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="8dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- SHOPS -->
                    <TextView
                        android:layout_marginTop="28dp"
                        android:text="Your Shops"
                        android:textSize="20sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textStyle="bold"
                        android:textColor="#111827"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_shops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"/>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="120dp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- FLOATING BUTTON -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@drawable/ic_add"
            app:backgroundTint="#6B21B6"
            app:tint="#FFFFFF"/>

        <!-- BOTTOM NAV -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#FFFFFF"
            app:itemIconTint="@color/bottom_nav_selected"
            app:itemTextColor="@color/bottom_nav_selected"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="#111827"
        app:itemIconTint="#6B7280"/>

</androidx.drawerlayout.widget.DrawerLayout>