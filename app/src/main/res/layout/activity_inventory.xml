<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    tools:context=".InventoryActivity">

    <!-- HEADER -->
    <TextView
        android:id="@+id/tvInventoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inventory"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SUMMARY CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInventorySummary"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvInventoryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- TOTAL ITEMS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Total Items"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColor="#6B7280"/>

                <TextView
                    android:id="@+id/tvTotalItems"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColor="#111827"/>
            </LinearLayout>

            <!-- LOW STOCK -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Low Stock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColor="#6B7280"/>

                <TextView
                    android:id="@+id/tvLowStock"
                    android:text="0"
                    android:textSize="24sp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textStyle="bold"
                    android:textColor="#DC2626"/>
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- SEARCH BAR -->
    <EditText
        android:id="@+id/etSearchInventory"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Search inventory..."
        android:padding="12dp"
        android:background="@drawable/bg_input_box"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardInventorySummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- INVENTORY LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInventory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/etSearchInventory"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_inventory"/>

</androidx.constraintlayout.widget.ConstraintLayout>