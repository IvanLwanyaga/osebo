    <dialog
        android:id="@+id/dialog_add_employee"
        android:name="com.osebo.ai.ui.fragments.AddEmployeeDialogFragment"
        android:label="Add Employee"
        tools:layout="@layout/dialog_add_employee" />

    <dialog
        android:id="@+id/dialog_add_role"
        android:name="com.osebo.ai.ui.fragments.AddRoleDialogFragment"
        android:label="Add Role"
        tools:layout="@layout/dialog_add_role" />

    <dialog
        android:id="@+id/dialog_filter"
        android:name="com.osebo.ai.ui.fragments.FilterDialogFragment"
        android:label="Filter"
        tools:layout="@layout/dialog_filter" />

    <dialog
        android:id="@+id/dialog_payment"
        android:name="com.osebo.ai.ui.fragments.PaymentDialogFragment"
        android:label="Payment"
        tools:layout="@layout/dialog_payment" />

</navigation>
