        tools:layout="@layout/fragment_transactions" />

    <fragment
        android:id="@+id/nav_subscription"
        android:name="com.osebo.ai.ui.fragments.SubscriptionPackageFragment"
        android:label="Packages"
        tools:layout="@layout/fragment_subscription_package" />

    <fragment
        android:id="@+id/nav_contact"
        android:name="com.osebo.ai.ui.fragments.FaqDetailsFragment"
        android:label="Contact Us"
        tools:layout="@layout/fragment_faq_details" />

    <!-- Additional Fragments -->
    <fragment
        android:id="@+id/fragment_add_expense"
        android:name="com.osebo.ai.ui.fragments.AddExpenseFragment"
        android:label="Add Expense"
        tools:layout="@layout/fragment_add_expense" />

    <fragment
        android:id="@+id/fragment_add_product"
        android:name="com.osebo.ai.ui.fragments.AddProductFragment"
        android:label="Add Product"
        tools:layout="@layout/fragment_add_product" />

    <fragment
        android:id="@+id/fragment_edit_shops"
        android:name="com.osebo.ai.ui.fragments.EditShopsFragment"
