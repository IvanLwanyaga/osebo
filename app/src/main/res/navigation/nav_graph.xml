    <fragment
        android:id="@+id/fragment_product_details"
        android:name="com.osebo.ai.ui.fragments.ProductDetailsFragment"
        android:label="Product Details"
        tools:layout="@layout/fragment_product_details" />

    <fragment
        android:id="@+id/fragment_restock"
        android:name="com.osebo.ai.ui.fragments.RestockFragment"
