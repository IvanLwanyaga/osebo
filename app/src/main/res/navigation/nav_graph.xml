        android:id="@+id/fragment_shop_settings"
        android:name="com.osebo.ai.ui.fragments.ShopSettingsFragment"
        android:label="Shop Settings"
        tools:layout="@layout/fragment_shop_settings" />

    <fragment
        android:id="@+id/fragment_subscription_details"
        android:name="com.osebo.ai.ui.fragments.SubscriptionDetailsFragment"
