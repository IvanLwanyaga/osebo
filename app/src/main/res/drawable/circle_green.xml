<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Solid green fill -->
    <solid android:color="#10B981" />

    <!-- Optional: Add stroke for definition -->
    <stroke
        android:width="1dp"
        android:color="#059669" />

    <!-- Optional: Fixed size -->
    <size
        android:width="40dp"
        android:height="40dp" />

</shape>