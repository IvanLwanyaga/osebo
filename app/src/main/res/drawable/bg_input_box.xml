<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft background -->
    <solid android:color="@color/bg_surface"/>

    <!-- Rounded corners -->
    <corners android:radius="18dp"/>

    <!-- Soft border -->
    <stroke
        android:width="1dp"
        android:color="@color/border"/>

    <!-- Internal spacing -->
    <padding
        android:left="14dp"
        android:right="14dp"
        android:top="10dp"
        android:bottom="10dp"/>

</shape>