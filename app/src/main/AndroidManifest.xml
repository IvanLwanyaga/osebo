<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Osebo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Osebo">
        <activity
            android:name=".activities.ShopsActivity"
            android:exported="false" />
        <!-- SPLASH (ENTRY POINT) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- FIRST SCREEN AFTER SPLASH -->
        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".DashboardActivity" />
        <activity android:name=".ReportsActivity" />
        <activity android:name=".InventoryActivity" />
        <activity android:name=".SalesActivity" />
        <activity android:name=".CreateShopActivity" />
        <activity android:name=".CreateSaleActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".ContactUsActivity" />
        <activity android:name=".MoreActivity" />
        <activity android:name=".HRActivity" />
        <activity android:name=".FinanceActivity" />
    </application>

</manifest>